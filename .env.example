# SUPABASE_URL: URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
# Configure no painel Secrets do AI Studio.
SUPABASE_URL=https://seu-projeto.supabase.co

# SUPABASE_ANON_KEY: Chave publica anonima (anon/public key) do Supabase.
# Configure no painel Secrets do AI Studio.
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_SUPABASE
